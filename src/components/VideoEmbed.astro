---
import type { Video } from '../data/videos';
import Icon from './Icon.astro';

interface Props { video: Video; eager?: boolean; showYear?: boolean }
const { video, eager = false, showYear = false } = Astro.props;
---
<figure class="video">
  <div class="video__frame">
    <button type="button" class="video__play" data-video-id={video.id} data-video-title={video.title}>
      <img
        src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
        alt=""
        width="480"
        height="360"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
      <span class="video__icon" aria-hidden="true"><Icon name="play" size={24} /></span>
      <span class="visually-hidden">Reproducir vídeo: {video.title}</span>
    </button>
  </div>
  <figcaption>
    {showYear && <span class="video__year">{video.year}</span>}
    <span class="video__title">{video.title}</span>
  </figcaption>
</figure>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.video__play');
    if (!button) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.videoId}?autoplay=1&rel=0`;
    iframe.title = button.dataset.videoTitle ?? 'Vídeo';
    iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    button.replaceWith(iframe);
    iframe.focus();
  });
</script>

<style>
  .video { margin: 0; }
  .video__frame { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--color-primary-ink); box-shadow: var(--shadow-sm); }
  .video__play { all: unset; position: absolute; inset: 0; cursor: pointer; }
  .video__play:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -3px; border-radius: var(--radius); }
  .video__play img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s var(--ease); }
  .video__play::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgb(10 42 115 / 28%)); }
  .video__play:hover img { transform: scale(1.03); }
  .video__icon {
    position: absolute; z-index: 1; left: 50%; top: 50%; translate: -50% -50%;
    display: grid; place-items: center; width: 64px; height: 64px; padding-left: 3px;
    border-radius: 50%; background: var(--color-primary); color: #fff;
    box-shadow: 0 8px 24px -6px rgb(0 65 196 / 55%), inset 0 1px 0 rgb(255 255 255 / 20%);
    transition: transform .25s var(--ease), background-color .2s;
  }
  .video__play:hover .video__icon { transform: scale(1.08); background: var(--color-primary-strong); }
  .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { display: grid; gap: var(--space-1); margin-top: var(--space-3); }
  .video__title { font-weight: 600; line-height: 1.35; }
  .video__year { font-size: var(--text-xs); font-weight: 600; color: var(--color-muted); font-variant-numeric: tabular-nums; }
</style>
