---
// Iconos de Phosphor (variante "bold", trazo uniforme) incrustados como SVG en línea.
const icons = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/bold/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: className } = Astro.props;
const svg = icons[`/node_modules/@phosphor-icons/core/assets/bold/${name}-bold.svg`];
if (!svg) throw new Error(`Icono desconocido: ${name}`);
const markup = svg.replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon ${className ?? ''}" `);
---
<Fragment set:html={markup} />
