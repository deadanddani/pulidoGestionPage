---
import { nav } from '../data/nav';
import { site } from '../data/site';
import { url } from '../lib/url';
import SubsidyNotice from './SubsidyNotice.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__home" href={url('')}>
        <img src={url('img/logo-mark.png')} alt="" width="220" height="196" class="site-footer__logo" />
        <img src={url('img/logo-text.png')} alt={site.legalName} width="225" height="47" class="site-footer__wordmark" />
      </a>
      <img src={url('img/sello-colegiado.png')} alt="Administrador de Fincas Colegiado" width="179" height="56" class="site-footer__seal" />
    </div>
    <address>
      <p class="site-footer__heading">Contacto</p>
      <strong translate="no">{site.legalName}</strong><br />
      {site.address.street}<br />
      {site.address.postalCode} {site.address.city} ({site.address.region})<br />
      <a href={`mailto:${site.email}`} translate="no">{site.email}</a><br />
      CIF {site.cif}
    </address>
    <nav aria-label="Pie de página">
      <p class="site-footer__heading">Secciones</p>
      <ul>
        <li><a href={url('')}>Inicio</a></li>
        {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-footer__social">
      <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <Icon name="linkedin-logo" size={22} />
      </a>
      <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube">
        <Icon name="youtube-logo" size={22} />
      </a>
    </div>
  </div>
  <div class="container">
    <SubsidyNotice />
  </div>
  <div class="container">
   <div class="site-footer__legal">
    <span>© <span translate="no">{site.legalName}</span> {year}</span>
    <a href={url('privacidad/')}>Política de Protección de Datos y Privacidad</a>
    <a href={url('cookies/')}>Política de Cookies</a>
    <button type="button" class="site-footer__cookies" data-cookie-settings>Preferencias de cookies</button>
   </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface); color: var(--color-muted); border-top: 1px solid var(--color-border);
    padding-block: var(--space-7) calc(var(--space-5) + env(safe-area-inset-bottom));
    font-size: var(--text-sm);
  }
  .site-footer a { color: var(--color-text); text-decoration: none; }
  .site-footer a:hover { color: var(--color-primary); text-decoration: underline; }
  .site-footer__grid { display: grid; gap: var(--space-6); margin-bottom: var(--space-6); }
  .site-footer__heading { margin: 0 0 var(--space-3); font-family: var(--font-display); font-size: var(--text-sm); font-weight: 700; color: var(--color-text); letter-spacing: -0.01em; }
  .site-footer__brand { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .site-footer__home { display: flex; align-items: center; gap: var(--space-2); }
  .site-footer__home:hover { text-decoration: none; }
  .site-footer__logo { height: 48px; width: auto; }
  .site-footer__wordmark { height: 24px; width: auto; }
  .site-footer__seal { height: 44px; width: auto; }
  address { font-style: normal; line-height: 1.7; }
  address strong { color: var(--color-text); }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .site-footer ul a { display: inline-flex; align-items: center; min-height: 36px; }
  .site-footer__social { display: flex; gap: var(--space-2); align-self: start; }
  .site-footer__social a {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border-radius: var(--radius-sm); border: 1px solid var(--color-border); color: var(--color-primary-ink);
    transition: border-color .2s var(--ease), color .2s var(--ease);
  }
  .site-footer__social a:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .site-footer__legal {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-border);
  }
  .site-footer__legal a, .site-footer__cookies { display: inline-flex; align-items: center; min-height: 44px; }
  .site-footer__legal > span { margin-right: auto; }
  .site-footer__cookies { background: none; border: 0; padding: 0; font: inherit; color: var(--color-text); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .site-footer__cookies:hover { color: var(--color-primary); }
  @media (min-width: 640px) { .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 960px) { .site-footer__grid { grid-template-columns: 1.4fr 1.3fr 1fr auto; } }
</style>
