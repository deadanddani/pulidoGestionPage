---
import { nav } from '../data/nav';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props { current?: string }
const { current } = Astro.props;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={url('')}>
      <img class="site-header__mark" src={url('img/logo-mark.png')} alt="" width="220" height="196" />
      <img class="site-header__wordmark" src={url('img/logo-text.png')} alt={site.legalName} width="225" height="47" />
    </a>
    <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="site-nav__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menú</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={current === item.href ? 'page' : undefined}
              class={item.href === 'presupuesto/' ? 'btn btn--primary' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: var(--z-header);
    padding-top: env(safe-area-inset-top);
    background: rgb(255 255 255 / 92%);
    border-bottom: 1px solid var(--color-border);
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header { background: rgb(255 255 255 / 80%); backdrop-filter: saturate(1.4) blur(12px); }
  }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: var(--header-h); flex-wrap: wrap; }
  /* La marca fija la altura de la primera fila para que no cambie al desplegar el menú móvil. */
  .site-header__brand { display: flex; align-items: center; gap: var(--space-2); text-decoration: none; min-height: var(--header-h); }
  .site-header__mark { height: 44px; width: auto; }
  .site-header__wordmark { height: 22px; width: auto; }
  .site-nav__toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-surface); cursor: pointer; touch-action: manipulation;
  }
  .site-nav__toggle:hover { border-color: var(--color-border-strong); }
  .site-nav__bars, .site-nav__bars::before, .site-nav__bars::after {
    display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--color-text); position: relative; content: '';
    transition: transform .25s var(--ease), background-color .2s;
  }
  .site-nav__bars::before { position: absolute; top: -6px; }
  .site-nav__bars::after { position: absolute; top: 6px; }
  [aria-expanded='true'] .site-nav__bars { background: transparent; }
  [aria-expanded='true'] .site-nav__bars::before { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .site-nav__bars::after { transform: translateY(-6px) rotate(-45deg); }
  .site-nav { display: none; flex-basis: 100%; padding-block: var(--space-2) var(--space-5); }
  .site-nav.is-open { display: block; }
  .site-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .site-nav a:not(.btn) {
    display: flex; align-items: center; min-height: 48px; padding-inline: var(--space-3);
    color: var(--color-text); text-decoration: none; border-radius: var(--radius-sm); font-weight: 600;
    transition: color .2s var(--ease), background-color .2s var(--ease);
  }
  .site-nav a:not(.btn):hover { color: var(--color-primary); background: var(--color-surface-alt); }
  .site-nav a[aria-current='page']:not(.btn) { color: var(--color-primary); background: var(--color-primary-soft); }
  .site-nav .btn { width: 100%; margin-top: var(--space-3); }
  .site-nav .btn[aria-current='page'] { box-shadow: 0 0 0 3px var(--color-primary-soft); }

  @media (min-width: 960px) {
    .site-header__inner { flex-wrap: nowrap; }
    .site-header__mark { height: 52px; }
    .site-header__wordmark { height: 26px; }
    .site-nav__toggle { display: none; }
    .site-nav, .site-nav.is-open { display: block; flex-basis: auto; padding: 0; }
    .site-nav ul { display: flex; align-items: center; gap: var(--space-1); }
    .site-nav a:not(.btn) { min-height: 44px; }
    .site-nav a[aria-current='page']:not(.btn) { background: transparent; box-shadow: inset 0 -2px 0 var(--color-primary); border-radius: 0; }
    .site-nav .btn { width: auto; min-height: 44px; margin: 0 0 0 var(--space-3); }
  }
</style>
