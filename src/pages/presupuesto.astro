---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<BaseLayout title="Solicitud de Presupuesto" current="presupuesto/" description="Solicite presupuesto para la administración de su comunidad de propietarios.">
  <PageHead title="Solicitud de Presupuesto" lead="Envíenos sus datos y nos pondremos en contacto con usted." />
  <section class="section container quote" aria-label="Formulario de presupuesto">
    <QuoteForm />
    <aside class="quote__aside" aria-label="Otras formas de contacto">
      <p class="quote__aside-title">¿Prefiere escribirnos?</p>
      <p class="quote__row"><Icon name="envelope-simple" class="quote__icon" /><a href={`mailto:${site.email}`} translate="no">{site.email}</a></p>
      <p class="quote__row"><Icon name="map-pin" class="quote__icon" /><span>{site.address.street}<br />{site.address.postalCode} {site.address.city}</span></p>
      <p class="quote__note">Los campos marcados con <span aria-hidden="true">*</span><span class="visually-hidden">asterisco</span> son obligatorios.</p>
    </aside>
  </section>
</BaseLayout>

<style>
  .quote { display: grid; gap: var(--space-6); align-items: start; }
  .quote__aside { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); }
  .quote__aside-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); letter-spacing: -0.015em; }
  .quote__row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-3); }
  .quote__row :global(.quote__icon) { margin-top: 3px; color: var(--color-primary); }
  .quote__note { margin: var(--space-5) 0 0; padding-top: var(--space-4); border-top: 1px solid var(--color-border); color: var(--color-muted); font-size: var(--text-sm); }
  @media (min-width: 960px) {
    .quote { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--space-7); }
    .quote__aside { position: sticky; top: calc(var(--header-h) + var(--space-5)); }
  }
</style>
