---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Icon from '../components/Icon.astro';
import { featuredVideo, videos } from '../data/videos';
import { team } from '../data/team';
import { site } from '../data/site';
import { url } from '../lib/url';
---
<BaseLayout title="Pulido Gestión. Administración de Fincas. Gestoría.">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">Administrador de Fincas Colegiado en {site.address.city}</p>
        <h1>Administración de Fincas y Gestoría</h1>
        <p class="hero__lead">{site.description}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={url('presupuesto/')}>Solicitar presupuesto</a>
          <a class="btn btn--ghost" href={site.portalUrl} target="_blank" rel="noopener">
            Acceso a gestiones en su comunidad
            <Icon name="arrow-up-right" size={16} />
            <span class="visually-hidden">(se abre en una pestaña nueva)</span>
          </a>
        </div>
      </div>
      <div class="hero__media">
        <h2 class="hero__video-title">Por qué trabajar con nosotros</h2>
        <VideoEmbed video={featuredVideo} eager />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ayuda-title">
    <div class="container">
      <h2 id="ayuda-title" class="section__title">¿En qué podemos ayudarle?</h2>
      <ul class="shortcuts">
        <li class="tile tile--team">
          <a href={url('equipo/')}>
            <span class="tile__faces" aria-hidden="true">
              {team.map((m) => <img src={url(m.photo)} alt="" width="450" height="461" loading="lazy" />)}
            </span>
            <span class="tile__body">
              <strong>Nuestro Equipo</strong>
              <span>Conozca a las personas que gestionan su comunidad.</span>
            </span>
            <Icon name="arrow-right" class="tile__arrow" />
          </a>
        </li>
        <li class="tile tile--quote">
          <a href={url('presupuesto/')}>
            <Icon name="file-text" size={32} class="tile__icon" />
            <span class="tile__body">
              <strong>Solicitud de Presupuesto</strong>
              <span>Envíenos los datos de su finca.</span>
            </span>
            <Icon name="arrow-right" class="tile__arrow" />
          </a>
        </li>
        <li class="tile tile--map">
          <a href={url('contacto/')}>
            <img class="tile__cover" src={url('img/mapa.png')} alt="" width="778" height="442" loading="lazy" />
            <span class="tile__body">
              <strong>Dónde Estamos</strong>
              <span>{site.address.street}, {site.address.city}.</span>
            </span>
            <Icon name="arrow-right" class="tile__arrow" />
          </a>
        </li>
        <li class="tile tile--media">
          <a href={url('multimedia/')}>
            <span class="tile__thumbs" aria-hidden="true">
              {videos.slice(0, 3).map((v) => <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" />)}
            </span>
            <span class="tile__body">
              <strong>Área Multimedia</strong>
              <span>Ponencias, entrevistas y propuestas en vídeo.</span>
            </span>
            <Icon name="arrow-right" class="tile__arrow" />
          </a>
        </li>
      </ul>
      <div class="social">
        <h2 id="social-title">Visítenos en</h2>
        <a href={site.social.linkedin} target="_blank" rel="noopener"><Icon name="linkedin-logo" /> LinkedIn</a>
        <a href={site.social.youtube} target="_blank" rel="noopener"><Icon name="youtube-logo" /> YouTube</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero: texto a la izquierda, vídeo a la derecha; fondo con luz azul suave desde la esquina */
  .hero {
    position: relative; overflow: hidden;
    padding-block: var(--space-7) var(--space-8);
    background:
      radial-gradient(60rem 30rem at 100% 0%, rgb(0 85 255 / 9%), transparent 60%),
      radial-gradient(40rem 24rem at 0% 100%, rgb(46 163 242 / 7%), transparent 60%),
      var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .hero__grid { display: grid; gap: var(--space-7); align-items: center; }
  .hero__eyebrow {
    margin-bottom: var(--space-4); padding-left: var(--space-3); border-left: 3px solid var(--color-primary);
    color: var(--color-primary-ink); font-weight: 600; font-size: var(--text-sm); line-height: 1.4;
  }
  .hero h1 { font-size: var(--text-3xl); letter-spacing: -0.035em; line-height: 1.05; max-width: 14ch; }
  .hero__lead { font-size: var(--text-lg); color: var(--color-muted); max-width: 44ch; margin-bottom: 0; }
  .hero__actions { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-6); }
  .hero__actions .btn { white-space: normal; text-align: center; }
  .hero__video-title { font-size: var(--text-base); letter-spacing: 0; font-weight: 600; color: var(--color-muted); margin-bottom: var(--space-3); }
  .hero__media :global(figcaption) { display: none; }
  .hero__media :global(.video__frame) { box-shadow: var(--shadow), 0 0 0 1px rgb(14 26 51 / 6%); }

  /* Accesos: bento asimétrico de 4 piezas (7/5 y 5/7 columnas) */
  .shortcuts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .tile a {
    position: relative; display: flex; flex-direction: column; gap: var(--space-4); height: 100%;
    padding: var(--space-5); overflow: hidden;
    background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius);
    color: var(--color-text); text-decoration: none;
    transition: border-color .25s var(--ease), box-shadow .25s var(--ease), transform .25s var(--ease);
  }
  .tile a:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow); transform: translateY(-2px); }
  .tile a:active { transform: translateY(0); }
  .tile__body { display: grid; gap: var(--space-1); padding-right: var(--space-6); margin-top: auto; }
  .tile__body strong { font-family: var(--font-display); font-size: var(--text-xl); letter-spacing: -0.02em; line-height: 1.2; }
  .tile__body span { color: var(--color-muted); }
  .tile a :global(.tile__arrow) {
    position: absolute; right: var(--space-5); bottom: var(--space-5);
    color: var(--color-primary); transition: transform .25s var(--ease);
  }
  .tile a:hover :global(.tile__arrow) { transform: translateX(4px); }

  .tile__faces { display: flex; padding-left: var(--space-2); }
  .tile__faces img {
    width: 64px; height: 64px; object-fit: cover; border-radius: 50%;
    margin-left: calc(-1 * var(--space-3)); border: 3px solid var(--color-surface); box-shadow: var(--shadow-sm);
  }

  .tile--quote a { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .tile--quote a:hover { background: var(--color-primary-strong); border-color: var(--color-primary-strong); }
  .tile--quote .tile__body span { color: rgb(255 255 255 / 86%); }
  .tile--quote a :global(.tile__arrow), .tile--quote a :global(.tile__icon) { color: #fff; }

  .tile__cover { margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) 0; width: calc(100% + 2 * var(--space-5)); max-width: none; aspect-ratio: 16 / 7; object-fit: cover; border-bottom: 1px solid var(--color-border); }

  .tile__thumbs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
  .tile__thumbs img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-sm); background: var(--color-surface-alt); }

  /* Redes: fila discreta bajo los accesos */
  .social { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); margin-top: var(--space-6); }
  .social h2 { margin: 0; font-size: var(--text-base); letter-spacing: 0; font-weight: 600; color: var(--color-muted); font-family: var(--font-sans); }
  .social a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; font-weight: 600; color: var(--color-primary-ink); text-decoration: none; }
  .social a:hover { color: var(--color-primary); text-decoration: underline; }

  @media (min-width: 640px) {
    .hero__actions { flex-direction: row; flex-wrap: wrap; }
    .shortcuts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile__faces img { width: 72px; height: 72px; }
  }
  @media (min-width: 960px) {
    .hero { padding-block: var(--space-8); }
    .hero__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-7); }
    .shortcuts { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(240px, auto); gap: var(--space-5); }
    .tile--team { grid-column: span 7; }
    .tile--quote { grid-column: span 5; }
    .tile--map { grid-column: span 5; }
    .tile--media { grid-column: span 7; }
    .tile a { padding: var(--space-6); }
    .tile a :global(.tile__arrow) { right: var(--space-6); bottom: var(--space-6); }
    .tile__cover { margin: calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) 0; width: calc(100% + 2 * var(--space-6)); }
  }
</style>
